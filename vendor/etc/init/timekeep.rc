on boot
    # Cấp quyền cho system đọc RTC
    chown system system /sys/class/rtc/rtc0/since_epoch
    chmod 0440 /sys/class/rtc/rtc0/since_epoch

on post-fs-data
    # Chỉ tạo folder trong vendor data (đúng chuẩn Treble)
    mkdir /data/vendor/time 0770 system system

# Service khôi phục giờ khi Boot
service vendor.timekeep /vendor/bin/timekeep restore
    class core                  # Chạy sớm hơn
    user root                   # Chạy quyền root để tránh lỗi 255
    group system
    capabilities SYS_TIME
    oneshot
    writepid /dev/cpuset/system-background/tasks

# Service lưu giờ (có thể gọi từ script hoặc app)
service vendor.timekeep_save /vendor/bin/timekeep store
    class last_start
    user root
    group system
    oneshot
    disabled                   # Chỉ chạy khi được gọi
